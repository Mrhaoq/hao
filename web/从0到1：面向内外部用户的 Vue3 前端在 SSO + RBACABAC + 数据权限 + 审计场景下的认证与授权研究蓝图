## 二、最小可行骨架（Vue3 + Pinia + Router + Axios）

下面提供关键机制的示例（变量名可自适配），以便快速落地。

### 1. useAuthSession（会话/令牌/刷新/跨页）

```ts
const state = reactive({
  accessToken: null,
  refreshToken: null,
  expiresAt: 0,
  user: null,
  refreshing: false
});

function login(redirectTo: string) {
  saveIntent(redirectTo);
  return oidc.loginRedirect();
}

async function handleCallback() {
  const tokens = await oidc.parseCallback();
  verifyStateNonce(tokens);
  Object.assign(state, tokens);
  await loadUserAndPolicy();
  restoreIntent();
}

async function getValidAccessToken() {
  const skew = 30000; // 30s 余量
  if (Date.now() < state.expiresAt - skew) {
    return state.accessToken;
  }
  return await singleFlightRefresh();
}

function singleFlightRefresh() {
  if (state.refreshing) {
    return waitForExistingPromise();
  }
  state.refreshing = true;
  return oidc.refresh()
    .then(t => Object.assign(state, t))
    .finally(() => { state.refreshing = false; });
}

// 跨页同步
useBroadcastChannel('auth', msg => {/* 更新或登出逻辑 */});
window.addEventListener('storage', /* 兜底处理 */);
```

### 2. 路由守卫（基于 meta 的统一判断）

```ts
router.beforeEach(async (to, from, next) => {
  if (to.meta.public) {
    return next();
  }
  if (!auth.isAuthenticated()) {
    return auth.login(to.fullPath);
  }
  if (!perm.initialized) {
    await perm.init(); // 拉策略并编译
  }
  if (!perm.allowsRoute(to)) {
    return next({ name: '403', query: { need: perm.missingOf(to) } });
  }
  return next();
});

router.afterEach((to, from) => {
  audit.routeNavigated({ to, from });
});
```

### 3. 权限指令 v-permit（按钮/区块显隐）

```ts
app.directive('permit', {
  mounted(el, binding) {
    const allowed = perm.check(binding.value); // roles/attrs/action
    if (!allowed) {
      el.style.display = 'none'; // 或禁用并展示申请入口
    }
  }
});
```

### 4. Axios 拦截器（令牌/范围/审计/错误一致性）

```ts
http.interceptors.request.use(async cfg => {
  cfg.headers['Authorization'] = 'Bearer ' + await auth.getValidAccessToken();
  cfg.headers['X-Request-Id'] = genId();
  cfg.headers['X-Tenant-Id'] = scope.tenantId;
  if (scope.dataScope) {
    cfg.headers['X-Data-Scope'] = JSON.stringify(scope.dataScope);
  }
  audit.attachContext(cfg);
  return cfg;
});

http.interceptors.response.use(
  res => {
    audit.onApiOk(res);
    return res;
  },
  async err => {
    const { config, response } = err;
    if (response?.status === 401 && !config._retried) {
      config._retried = true;
      await auth.refresh();
      return http(config);
    }
    if (response?.status === 403) {
      audit.onForbidden(config, response);
    }
    audit.onApiError(err);
    throw err;
  }
);
```

### 5. 数据范围上下文（provide/inject）

```ts
const ScopeSymbol = Symbol('scope');

export function provideScope() {
  const s = reactive({
    tenantId: null,
    orgId: null,
    projectId: null,
    dataScope: null
  });
  provide(ScopeSymbol, s);
  return s;
}

export function useScope() {
  return inject(ScopeSymbol)!;
}
```

### 6. 审计客户端（事件最小集）

- **事件字段**：`ts`、`actorId`、`sessionId`、`route`、`action`、`objectType/objectId`、`requestId`、`result`、`evidenceHash`、`clientMeta`
- **挂点**：`router.afterEach`、Axios 请求/响应 拦截、关键按钮点击
- **机制**：批量上报、失败重传、隐私字段白名单过滤

